@import "./base"

colors = {
  black: #212121,
  white: #ffffff,
  grey: #E8EAE8,
}

$white-color = colors.white
$black-color = colors.black
$grey-color = colors.grey

$font-primary  = Manrope, Arial, sans-serif
$font-secondary = Crimson Text, Arial, sans-serif

tablet = "only screen and (max-width: 1012px)"
tablet-up = "only screen and (min-width: 1013px)"
mobile = "only screen and (max-width: 748px)"
mobile-up = "only screen and (min-width: 749px)"

h1
  font-family $font-secondary
  font-size 72px
  line-height 125%
  letter-spacing 0.72px
  text-transform: uppercase
  media tablet
    font-size 56px
    letter-spacing 0.56px
  @media mobile
    font-size 40px
    letter-spacing 0.40px

h2
  font-family $font-primary
  font-size 48px
  line-height 125%
  letter-spacing: -0.96px
  font-weight: 500
  text-align: center
  max-width: 90%
  @media tablet
    font-size 40px
    letter-spacing: -0.80px
  @media mobile
    font-size 32px
    letter-spacing: -0.64px

h3
  font-size 32px
  line-height 125%
  letter-spacing: -0.64px
  font-family $font-primary
  text-transform: uppercase
  @media tablet
    font-size 24px
    letter-spacing: -0.72px
  @media mobile
    font-size 20px
    letter-spacing: -0.40px

p
  font-size 20px
  line-height 150%
  font-weight 400
  font-family $font-primary
  @media tablet
    font-size 16px
  @media mobile
    font-size 14px

#app
  font-family $font-primary
  -webkit-font-smoothing antialiased
  -moz-osx-font-smoothing grayscale
  width 100vw
  max-width: 100vw
  min-height 100vh
  display flex
  flex-direction: column
  background: $black-color
  color $white-color

html
  width: 100vw

section, header
  padding-left 32px
  padding-right 32px
  @media mobile 
    padding-right: 16px
    padding-left: 16px